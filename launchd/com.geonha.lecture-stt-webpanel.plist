<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.geonha.lecture-stt-webpanel</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/geonha/lecture_stt</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/geonha/lecture_stt/scripts/run_gui.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>WEB_PANEL_HOST</key>
    <string>127.0.0.1</string>
    <key>WEB_PANEL_PORT</key>
    <string>8765</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/geonha/lecture_stt/state/logs/webpanel.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/geonha/lecture_stt/state/logs/webpanel.err.log</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
